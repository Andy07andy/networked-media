<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>ENERGY | BaZi Drinks</title>

  <!-- 字体 -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Rampart+One&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="landing-container">
    <div class="energy-word">
      <span class="letter" data-explanation="E: Element balance">E</span>
      <span class="letter" data-explanation="N: Nature-based insights">N</span>
      <span class="letter" data-explanation="E: Energy alignment">E</span>
      <span class="letter" data-explanation="R: Ritual as habit">R</span>
      <span class="letter" data-explanation="G: Growth through awareness">G</span>
      <span class="letter" data-explanation="Y: Yin-Yang harmony">Y</span>
    </div>

    <div class="slogan hidden">
      Balance your energy, one drink at a time<br>
      — guided by the wisdom of Bazi.
    </div>

    <button class="cta-button hidden" onclick="window.location.href='/login'">Start Your Ritual</button>

    <div class="scroll-hint" id="scrollHint">↓ SCROLL ↓</div>
  </div>

  <script>
    let triggered = false;
    window.addEventListener('wheel', () => {
      if (!triggered) {
        document.querySelector('.energy-word').classList.add('scattered');
        document.querySelector('.slogan').classList.remove('hidden');
        document.querySelector('.cta-button').classList.remove('hidden');
  
        // 立刻移除 scroll 提示（无过渡）
        const hint = document.getElementById('scrollHint');
        hint.remove(); // 或 hint.style.display = 'none';
  
        triggered = true;
      }
    });
  </script>
  
  
</body>
</html>
