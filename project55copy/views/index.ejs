<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>注册 八字饮品推荐</title><link rel="stylesheet" href="/style.css">
</head>
<body>
  
  <h2>注册</h2>
  <form action="/signup" method="POST">
    用户名: <input name="username" required /><br>
    密码: <input name="password" type="password" required /><br>
    出生年月日时: <input name="year" required /> 年 
                <input name="month" required /> 月 
                <input name="day" required /> 日 
                <input name="hour" required /> 时<br>
    <button type="submit">注册</button>
  </form>
  <p><a href="/login">已有账户？点击登录</a></p>
  <% if (error) { %><p style="color:red;"><%= error %></p><% } %>
  

</body>
</html>


