<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Today’s Drink</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body >
  <nav class="navbar">
    <a href="/result" class="active">Today's Drink</a>
    <a href="/previous">History</a>
    <a href="/about" >About Project</a>
    <a href="/logout">Logout</a>
  </nav>

  <% if (recommendedDrink) { %>
    <div class="result-layout">
      <div class="left-panel">
        <img src="<%= recommendedDrink.image %>" alt="<%= recommendedDrink.name %>">
      </div>
      <div class="right-panel">
        <h1><%= recommendedDrink.name %></h1>
        <p><strong>Ingredients:</strong> <%= Array.isArray(recommendedDrink.ingredients) ? recommendedDrink.ingredients.join(', ') : "N/A" %></p>

        <p><strong>Flavor Profile:</strong> <%= recommendedDrink.flavorProfile %></p>
        <p><strong>Recommended Time:</strong> <%= recommendedDrink.timeOfDay %></p>
        <p><strong>Element Affinity:</strong> <%= Array.isArray(recommendedDrink.elements) ? recommendedDrink.elements.join(', ') : "Wood + Water" %></p>

        <p><strong>Mood Match:</strong> <%= recommendedDrink.mood %></p>
        <p><strong>Bazi Insight:</strong> <%= recommendedDrink.baziComment %></p>
      </div>
    </div>
    
  <% } else { %>
    <p class="no-recommendation">No special drink for today. Embrace the moment! ✨</p>
  <% } %>
</body>
</html>
