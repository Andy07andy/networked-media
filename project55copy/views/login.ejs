<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>登录 八字饮品推荐</title><link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="auth-box">
    <h2>登录</h2>
    <form action="/login" method="POST" autocomplete="off">
      用户名: <input type="text" name="username" required /><br>
      密码: <input type="password" name="password"  required /><br>
      <button type="submit">登录</button>
    </form>
    <p><a href="/signup">没有账户？点击注册</a></p>
  </div>
  

</body>
</html>
