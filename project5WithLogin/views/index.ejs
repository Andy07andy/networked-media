<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>八字饮品推荐</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<% if (user) { %>
<header>
  <a href="/history">历史记录</a>
  <a href="/about">关于项目</a>
  <a href="/logout">登出</a>
</header>
<% } %>

<div class="container">
  <h1>八字饮品推荐</h1>
  <form action="/result" method="POST">

    <% if (!user) { %>
      <h2>出生信息</h2>
      <label>年份：<input type="number" name="year" required></label><br><br>
      <label>月份：<input type="number" name="month" required></label><br><br>
      <label>日期：<input type="number" name="day" required></label><br><br>
      <label>时辰（24小时制0-23）：<input type="number" name="hour" min="0" max="23" required></label><br><br>
    <% } else { %>
      <p><strong>欢迎回来，<%= user.username %>！</strong></p>
      <p>你的生日是：<%= user.birthday %>（将自动用于推荐）</p>
    <% } %>

    <h2>饮品偏好</h2>
    <label>是否接受含酒精饮品？</label><br>
    <input type="radio" name="alcoholPreference" value="Alcoholic" required> 是<br>
    <input type="radio" name="alcoholPreference" value="Non_Alcoholic" required> 否<br><br>

    <label>过敏成分（可选，多种用英文逗号分隔）:</label><br>
    <input type="text" name="allergies" placeholder="例如 milk,nuts"><br><br>

    <button type="submit">开始生成推荐</button>
  </form>
</div>
</body>
</html>
