<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>推荐结果</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <h1>饮品推荐结果</h1>

  <h2>🧭 八字分析</h2>
  <p><strong>日干:</strong> <%= dayGan %> （五行: <%= userElement %>）</p>
  <p><strong>月支:</strong> <%= monthBranch %> （五行: <%= monthElement %>）</p>
  <p><strong>身强/身弱判断:</strong> <%= bodyStatus %></p>
  <p><strong>适合补充的五行:</strong> <%= neededElement %></p>

  <h2>📅 今日运势分析</h2>
  <p><strong>今天是:</strong> <%= todayDayGanZhi %> 日（天干: <%= todayStem %>, 五行: <%= todayElement %>）</p>
  <p><strong>今日顺/逆势:</strong> <%= todayStatus %></p>

  <h2>🍹 用户饮品偏好</h2>
  <p>偏好类型: <%= alcoholPreference %></p>
  <p>过敏成分: <%= allergies || "无" %></p>

  <% if (recommendedDrink) { %>
    <h2>🎉 推荐饮品</h2>
    <p><strong><%= recommendedDrink.name %></strong></p>
    <img src="<%= recommendedDrink.image %>" alt="Drink Image" width="200"><br>
    <p>主要成分：<%= recommendedDrink.ingredients.join(", ") %></p>
  <% } else { %>
    <p>未找到合适饮品 😢</p>
  <% } %>

  <p><a href="/">返回主页</a></p>
</body>
</html>
