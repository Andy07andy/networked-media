<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>注册</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <h1>注册新账号</h1>
  <form method="POST" action="/register">
    <label>用户名: <input type="text" name="username" required></label><br><br>
    <label>密码: <input type="password" name="password" required></label><br><br>
    <label>生日: <input type="date" name="birthday" required></label><br><br>
    <button type="submit">注册</button>
  </form>
  <p>已有账号？<a href="/login">去登录</a></p>
</body>
</html>
