<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Previous Recommendations</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/result">Today's Drink</a>
    <a href="/previous" class="active">History</a>
    <a href="/about" >About Project</a>
    <a href="/logout">Logout</a>
  </nav>

  <h1 class="tit">🍹 Previous Drink Recommendations</h1>

  <% if (previous.length) { %>
    <div class="centered-grid">
      <% previous.forEach(item => { %>
        <div class="card">
          <% if (item.drink.image) { %>
            <img src="<%= item.drink.image %>" alt="Drink Image">
          <% } %>
          <h3><%= item.date %></h3>
          <p><%= item.drink.name %></p>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p>No drink history yet~</p>
  <% } %>
  
</body>
</html>
