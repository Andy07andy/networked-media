<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>历史推荐</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav>
    <a href="/result">今日推荐</a> |
    <a href="/logout">退出登录</a>
  </nav>
  <h1>🍹 历史饮品推荐</h1>
  <% if (previous.length) { %>
    <ul>
      <% previous.forEach(item => { %>
        <li>
          <h3><%= item.date %> — <%= item.drink.name %></h3>
          <% if (item.drink.image) { %>
            <img src="<%= item.drink.image %>" width="150">
          <% } %>
          <p>成分：<%= item.drink.ingredients.join(', ') %></p>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>还没有历史记录哦～</p>
  <% } %>
</body>
</html>
