<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>注册 八字饮品推荐</title><link rel="stylesheet" href="/style.css">
</head>
<body>
  
  <h1>注册一个账号</h1>
  <% if (error) { %><p style="color:red;"><%= error %></p><% } %>
  <form action="/signup" method="POST">
    <label>用户名：<input name="username" required></label><br><br>
    <label>密码：<input type="password" name="password" required></label><br><br>
    <label>确认密码：<input type="password" name="confirmPassword" required></label><br><br>
    <h2>出生信息</h2>
    <label>年份：<input type="number" name="year" required></label><br><br>
    <label>月份：<input type="number" name="month" required></label><br><br>
    <label>日期：<input type="number" name="day" required></label><br><br>
    <label>时辰（0-23）：<input type="number" name="hour" min="0" max="23" required></label><br><br>
    <button type="submit">注册并获取今日推荐</button>
  </form>
  <p>已有账号？<a href="/login">返回登录</a></p>

</body>
</html>
